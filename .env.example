# Optional provider credentials. The deterministic report path works without them.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL_SMALL=gpt-4o-mini
LLM_MODEL_NARRATE=gpt-4o-mini
RELIEFWEB_APPNAME=DisasterRes-Net
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_S=180

# Image Search APIs (used by crew/tools/image_search.py)
# Note: Free fallbacks (Wikimedia Commons & GDELT) are used automatically if these keys are absent.
SERPER_API_KEY=
SERPAPI_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# Web Application Settings
DISASTERRES_MAX_UPLOAD_BYTES=12582912
DISASTERRES_MAX_ANALYSIS_EDGE=1280
DISASTERRES_MAX_RESPONSE_EDGE=960

# Model Training & Execution Settings
DISASTERRES_NUM_WORKERS=0
DISASTERRES_TORCH_TRAIN=0
DISASTERRES_TORCH_EPOCHS=3
DISASTERRES_TORCH_BATCH_SIZE=32
DISASTERRES_TORCH_LR=3e-4
DISASTERRES_TORCH_WEIGHT_DECAY=1e-4
DISASTERRES_TORCH_VAL_FRACTION=0.15
DISASTERRES_TORCH_SEED=42
DISASTERRES_TORCH_LABEL_SMOOTHING=0.05
